<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="mark_present_today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_present"
        android:shortcutShortLabel="@string/shortcut_mark_present_short"
        android:shortcutLongLabel="@string/shortcut_mark_present_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.eightyendance.rcxkmv"
            android:targetClass="com.example.MainActivity">
            <extra
                android:name="extra_shortcut_action"
                android:value="shortcut_mark_present" />
        </intent>
    </shortcut>

